# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Claude API key. Leave empty to run everything against the mock LLM.
ANTHROPIC_API_KEY=

# mock      -> always use the mock LLM (deterministic, no network)
# anthropic -> always call Claude (fails at startup without ANTHROPIC_API_KEY)
# auto      -> Claude when a key is set, mock otherwise (default)
LLM_MODE=auto

# Claude model id. Empty uses the default (claude-opus-5-5).
ANTHROPIC_MODEL=

# debug, info (default), warn or error. Requests are logged at info;
# /healthz and /readyz (polled by the container healthcheck) only at debug.
LOG_LEVEL=info

# Size and random seed of the fake user population. Same values -> same users.
SEED_USERS=5000
SEED_RANDOM=42

# Messages per second and channel sent to the provider (case requirement: 100).
SEND_RATE_PER_SECOND=100

# Mock provider behaviour: probability per request of a 5xx, a 429 and an
# accepted-but-unconfirmed message; latency range in milliseconds.
MOCK_ERROR_RATE=0.05
MOCK_RATE_LIMIT_RATE=0.01
MOCK_LOST_REPLY_RATE=0.01
MOCK_MIN_LATENCY_MS=20
MOCK_MAX_LATENCY_MS=250
